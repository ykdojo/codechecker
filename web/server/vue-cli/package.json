{
  "name": "codechecker",
  "version": "1.0.0",
  "description": "CodeChecker viewer.",
  "author": "Márton Csordás",
  "private": true,
  "scripts": {
    "build": "rimraf dist && cross-env NODE_ENV=production webpack --config config/webpack.prod.js",
    "server:codechecker": "CodeChecker server --port 8002 -w e2e/__codechecker/workspace > e2e/__codechecker/server.log",
    "server:dev": "cross-env NODE_ENV=development webpack server --hot --progress --config config/webpack.dev.js",
    "server:prod": "http-server dist -c-1 --cors",
    "server": "npm run server:dev",
    "start": "npm run server",
    "test:clean": "npm run test:e2e.clean",
    "test:e2e": "npm run test:e2e.firefox && npm run test:e2e.chrome",
    "test:e2e.clean": "rimraf e2e/output e2e/screenshots e2e/__codechecker/workspace e2e/__codechecker/reports e2e/__codechecker/compilation_database",
    "test:e2e.chrome": "server-test test:e2e.server http-get://localhost:8002/ready 'npm run test:e2e.init-db && npm run test:nightwatch -- -e selenium.chrome'",
    "test:e2e.firefox": "server-test test:e2e.server http-get://localhost:8002/ready 'npm run test:e2e.init-db && npm run test:nightwatch -- -e selenium.firefox'",
    "test:e2e.init-db": "node e2e/init.db.js",
    "test:e2e.init-reports": "node e2e/init.reports.js",
    "test:e2e.init-workspace": "node e2e/init.workspace.js",
    "test:e2e.server": "npm run test:e2e.init-reports && rimraf e2e/__codechecker/workspace && npm run test:e2e.init-workspace && npm run server:codechecker",
    "test:lint": "eslint --ext .js,.vue src",
    "test:nightwatch": "nightwatch",
    "test:unit": "jest",
    "test": "npm run test:lint && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@mdi/font": "^7.3.67",
    "codechecker-api": "file:../../api/js/codechecker-api-node/dist/codechecker-api-6.63.0.tgz",
    "chart.js": "^4.4.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "codemirror": "^5.65.0",
    "date-fns": "^2.30.0",
    "js-cookie": "^3.0.5",
    "jsplumb": "^2.15.6",
    "lodash": "^4.17.21",
    "marked": "^9.1.2",
    "pinia": "^2.1.7",
    "semver": "^7.5.4",
    "splitpanes": "^3.1.5",
    "vue": "^3.3.7",
    "vue-chartjs": "^5.2.0",
    "vue-router": "^4.2.5",
    "vuetify": "^3.3.23",
    "mitt": "^3.0.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.2",
    "@babel/preset-env": "^7.23.2",
    "@types/jest": "^29.5.7",
    "@vitejs/plugin-vue": "^4.4.0",
    "@vue/compiler-sfc": "^3.3.7",
    "@vue/test-utils": "^2.4.1",
    "babel-core": "^7.0.0-bridge.0",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "buffer": "^6.0.3",
    "copy-webpack-plugin": "^11.0.0",
    "core-js": "^3.33.2",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "deepmerge": "^4.3.1",
    "eslint": "^8.52.0",
    "eslint-plugin-vue": "^9.18.1",
    "eslint-webpack-plugin": "^4.0.1",
    "file-loader": "^6.2.0",
    "geckodriver": "^4.2.1",
    "html-webpack-plugin": "^5.5.3",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "nightwatch": "^3.3.3",
    "raw-loader": "^4.0.2",
    "regenerator-runtime": "^0.14.0",
    "rimraf": "^5.0.5",
    "sass": "^1.69.5",
    "sass-loader": "^13.3.2",
    "selenium-server": "^3.141.59",
    "start-server-and-test": "^2.0.1",
    "util": "^0.12.5",
    "vue-loader": "^17.3.0",
    "vue-style-loader": "^4.1.3",
    "vue-template-compiler": "^2.7.15",
    "vuetify-loader": "^3.1.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-merge": "^5.10.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "vue"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "@cc/report-server-types": "codechecker-api/lib/report_server_types.js",
      "@cc/prod-types": "codechecker-api/lib/products_types.js"
    },
    "transform": {
      "^.+\\.vue$": "@vue/vue3-jest",
      "^.+\\.js$": "babel-jest"
    },
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "customExportConditions": ["node", "node-addons"]
    }
  }
}